{
  "name": "mullion-session-manager",
  "version": "0.3.42",
  "type": "module",
  "description": "Self-hosted, tiled, persistent browser dashboard for host-run AI CLI terminals (Claude Code, Codex, opencode, ...)",
  "license": "AGPL-3.0-or-later",
  "main": "dist/server.js",
  "bin": {
    "mullion": "dist/cli/mullion.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "tsx watch src/server.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "tsc -p tsconfig.build.json && cp -r src/hooks dist/hooks && cp -r src/mcp dist/mcp && cp -r src/cli dist/cli && cp -r src/bundle dist/bundle && mkdir -p dist/docs && cp docs/agent-guide.md dist/docs/agent-guide.md && npm run build:smoke-test",
    "build:smoke-test": "node --input-type=module -e \"await import('./dist/app.js');\"",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:all": "concurrently -n backend,frontend -c blue,green \"npm:test\" \"npm --prefix frontend run test\"",
    "lint": "eslint . && npm run check:env-docs && npm run check:scaffold-region-sync && npm run check:review-protocol-sync && npm run check:ssh-agent-filter-vectors && npm run check:security-antipatterns",
    "lint:all": "concurrently -n backend,frontend -c blue,green \"npm:lint\" \"npm --prefix frontend run lint\"",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "concurrently -n backend,frontend -c blue,green \"npm:typecheck\" \"npm --prefix frontend run typecheck\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "check:env-docs": "node scripts/check-env-docs.mjs",
    "check:scaffold-region-sync": "node scripts/check-scaffold-region-sync.mjs",
    "check:review-protocol-sync": "node scripts/check-review-protocol-sync.mjs",
    "check:ssh-agent-filter-vectors": "tsx scripts/generate-ssh-agent-filter-vectors.ts --check",
    "generate:ssh-agent-filter-vectors": "tsx scripts/generate-ssh-agent-filter-vectors.ts",
    "check:security-antipatterns": "node scripts/check-security-antipatterns.mjs",
    "check:patch-coverage": "node scripts/check-patch-coverage-hook.mjs",
    "test:patch-coverage": "node scripts/check-patch-coverage.mjs",
    "check:scope-leaks": "tsx scripts/check-scope-leaks.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/env": "^7.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@yume-chan/adb": "^2.6.4",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/scrcpy": "^2.3.0",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.4.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "node-pty": "^1.1.0",
    "openid-client": "^6.8.8",
    "pino": "^10.4.0",
    "playwright": "^1.64.1",
    "safe-regex2": "^5.1.2",
    "smol-toml": "1.9.1",
    "undici": "^8.12.1",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.4",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.1",
    "eslint": "^10.12.0",
    "jose": "^6.2.10",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "shell-quote": "^1.9.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true
  }
}
