{
  "name": "mullion-session-manager",
  "version": "0.3.6",
  "type": "module",
  "description": "Self-hosted, tiled, persistent browser dashboard for host-run AI CLI terminals (Claude Code, Codex, opencode, ...)",
  "license": "AGPL-3.0-or-later",
  "main": "dist/server.js",
  "bin": {
    "mullion": "dist/cli/mullion.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "tsx watch src/server.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "tsc -p tsconfig.build.json && cp -r src/hooks dist/hooks && cp -r src/mcp dist/mcp && cp -r src/cli dist/cli && cp -r src/bundle dist/bundle && mkdir -p dist/docs && cp docs/agent-guide.md dist/docs/agent-guide.md && npm run build:smoke-test",
    "build:smoke-test": "node --input-type=module -e \"await import('./dist/app.js');\"",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:all": "concurrently -n backend,frontend -c blue,green \"npm:test\" \"npm --prefix frontend run test\"",
    "lint": "eslint . && npm run check:env-docs && npm run check:briefing-sync && npm run check:ssh-agent-filter-vectors",
    "lint:all": "concurrently -n backend,frontend -c blue,green \"npm:lint\" \"npm --prefix frontend run lint\"",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "concurrently -n backend,frontend -c blue,green \"npm:typecheck\" \"npm --prefix frontend run typecheck\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "check:env-docs": "node scripts/check-env-docs.mjs",
    "check:briefing-sync": "node scripts/check-briefing-sync.mjs",
    "check:ssh-agent-filter-vectors": "tsx scripts/generate-ssh-agent-filter-vectors.ts --check",
    "generate:ssh-agent-filter-vectors": "tsx scripts/generate-ssh-agent-filter-vectors.ts",
    "build:helper-sea": "node scripts/build-helper-sea.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.5",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "node-pty": "^1.1.0",
    "openid-client": "^6.8.7",
    "pino": "^10.3.1",
    "playwright": "^1.62.1",
    "smol-toml": "1.8.0",
    "undici": "^8.10.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.1",
    "jose": "^6.2.10",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "shell-quote": "^1.9.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true
  }
}
