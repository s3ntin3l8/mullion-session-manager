# Copy to .env and adjust. All values have safe defaults (see src/plugins/env.ts).
# Keys are sorted alphabetically to match the schema there.

# Phase 3 (#179) — gates the whole Playwright-driven Controllable Browser
# feature. Default false: BrowserManager refuses to launch Chromium and the
# browser WS/REST routes return a clear 4xx until this is enabled. See
# deploy/README.md's Playwright/Chromium prerequisites before turning this on.
BROWSER_ENABLED=false

# Where per-project Playwright storage state (cookies/localStorage) is
# written so a project's browser starts already-authenticated across
# restarts. Cwd-relative default matches SESSIONS_DIR's own convention — a
# versioned-release install overrides this to an absolute path instead (see
# deploy/install.sh), same reasoning as SESSIONS_DIR.
BROWSER_DATA_DIR=./data/browsers

# Target frames-per-second for the CDP screenshot stream (issue #180).
BROWSER_FRAMERATE=10

# Max concurrent Chromium instances in the pool (one per project). Bounds
# host memory — each headless instance is real memory even at idle.
BROWSER_MAX_INSTANCES=4

# Comma-separated CORS allowlist (e.g. https://app.example.com,https://admin.example.com).
# Empty disables cross-origin requests.
CORS_ORIGIN=

# Global (non-per-project) launcher/dock config dir — see
# src/services/project-config.ts. A project's own .crs/ dir always takes
# precedence over this. "~" is expanded to the server's home dir.
CRS_CONFIG_DIR=~/.config/crs

# SQLite database location (file: URL).
DATABASE_URL=file:./data/app.db

# Optional. Enables AES-256-GCM encryption-at-rest for flagged columns
# (e.g. stored GitHub tokens — see docs/github-integration.md).
# Must be a base64url-encoded 32-byte key. Leave empty to disable encryption.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DB_ENCRYPTION_KEY=

# Built frontend assets dir (frontend/ has its own package.json — `npm run
# build` there emits this dir). Resolved relative to the process cwd.
# Served at "/" once it exists; see src/plugins/static.ts.
FRONTEND_DIST=./frontend/dist

# GitHub OAuth App client id (issue #27) — a public identifier, not a
# secret. Optional: leave empty to use PAT-only GitHub integration; set
# this to also enable the device-flow "Connect with GitHub" button. See
# docs/github-integration.md.
GITHUB_OAUTH_CLIENT_ID=

# Seconds between adaptive poller ticks when a repo has open PRs or
# running CI — lower trades responsiveness for rate-limit budget. See
# docs/github-integration.md.
GITHUB_POLL_INTERVAL_ACTIVE=15

# Seconds between adaptive poller ticks when no repo has open PRs or
# running CI — matches the original pre-webhook poll interval. See
# docs/github-integration.md.
GITHUB_POLL_INTERVAL_QUIET=60

# Seconds without a webhook delivery before the poller goes into stalled
# mode and does a safety-net re-sync at 30s. See docs/github-integration.md.
GITHUB_POLL_STALE_THRESHOLD=300

# Log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port the server listens on.
PORT=3000

# Base host for the subdomain preview proxy (issue #28) — a project dev
# server or external URL is embedded in-dashboard at
# "preview-<slug>.<PREVIEW_BASE_HOST>". Leave empty to disable the feature
# entirely (no preview routes are registered). Setting this in production
# requires wildcard DNS (*.<PREVIEW_BASE_HOST>) and a wildcard TLS cert —
# see docs/browser-previews.md and deploy/README.md.
PREVIEW_BASE_HOST=

# Preview-host auth token (issue #383) — when true, previewProxyPlugin
# requires a valid bootstrap token (minted via an authenticated dashboard
# session, POST /api/previews/:slug/token) or preview cookie before proxying
# a preview-host request, on top of whatever gateway forwardAuth already sits
# in front. Default false: turning this on breaks direct/bookmarked
# navigation straight to a preview URL. Requires MULLION_SESSION_SECRET to be
# set — see docs/auth.md.
PREVIEW_AUTH_REQUIRED=false

# Comma-separated list of directories to scan (immediate subdirectories only)
# for candidate projects — see GET /api/projects/discover. Empty disables
# discovery (opt-in only).
PROJECTS_ROOTS=

# Rate limiting: max requests per window, and the window length.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Directory holding one dtach socket per terminal session. In production this
# should be an absolute path under the host user's state dir, e.g.
# /home/<user>/.local/state/claude-remote-session/sockets — see the deploy/
# systemd unit. Sessions survive as long as this directory does, independent
# of this process's own lifecycle/redeploys.
SESSIONS_DIR=./data/sessions

# Required when MULLION_ROLE=agent (the process refuses to boot without one).
# Shared secret the internal API requires on every request. Unused when
# MULLION_ROLE=primary — per-remote-host tokens instead live in that
# primary's own `hosts` DB table (Settings -> Hosts).
MULLION_AGENT_TOKEN=

# MULLION_ROLE=primary only — seconds between liveness sweeps of every
# registered remote host's (already-unauthenticated) /health route, driving
# the health dot in Settings -> Hosts. 0 disables the poller entirely.
HOST_HEARTBEAT_INTERVAL_SECONDS=30

# Optional in-process auth (issue #19) for MULLION_ROLE=primary — a single
# shared token gating every HTTP route and /ws/terminal, independent of any
# reverse-proxy gateway. Leave empty to keep today's behavior (rely entirely
# on a gateway like Traefik+Authentik, or nothing, at your own risk — a
# clear warning is logged at boot when this is unset). Setting this also
# requires MULLION_SESSION_SECRET below. Generate with:
#   openssl rand -hex 32
MULLION_AUTH_TOKEN=

# Absolute path to the versioned-release install root — the parent of
# releases/, the `current` symlink, and data/ — see deploy/README.md and
# deploy/install.sh. Leave empty for a dev checkout (`make dev`) or any
# install not using the versioned-release layout: the update checker
# (GET /api/updates/check) still works, but applying an update
# (POST /api/updates/apply) refuses without this set.
MULLION_HOME=

# Native OIDC login (issue #30) for MULLION_ROLE=primary — a second way
# (alongside MULLION_AUTH_TOKEN above) to mint the same session cookie, via
# an OIDC provider (e.g. Authentik) instead of a shared token. All four keys
# below must be set together, or all left empty — the process refuses to
# boot on a partial set. Setting these also requires MULLION_SESSION_SECRET.
# This process is a confidential client: it holds MULLION_OIDC_CLIENT_SECRET
# and does the code exchange server-side, so the SPA never sees an OIDC
# token.
MULLION_OIDC_ISSUER=
MULLION_OIDC_CLIENT_ID=
MULLION_OIDC_CLIENT_SECRET=
# Must exactly match a redirect URI registered at the provider, e.g.
# https://mullion.example.com/api/auth/oidc/callback
MULLION_OIDC_REDIRECT_URI=

# Whether the Claude Code hook adapter registers the blocking PreToolUse
# review gate on Bash (issue #178) — see docs/agent-hooks.md. Default false:
# an unattended/autonomous session has nobody to click Approve/Deny, so
# gating every Bash call by default stalls it on every shell command until
# the server-side timeout fails it closed (denied). Enable only when a human
# is actually watching for the pending-review indicator and will act on it.
MULLION_REVIEW_GATE_ENABLED=false

# Task Master — deploy-time DEFAULT for whether autonomous behavior is on:
# the background watcher's GitHub ingest + auto-claim, and the claim/approve
# endpoints. Overridable at runtime without a restart via Settings -> Task
# Master (settings.taskMaster.enabled) — this env var only matters until
# someone flips that toggle. Default false. Does NOT gate reject (the
# escape hatch for a task already in review), an already-claimed task's
# budget enforcement/status sync, or the local task board (create/edit/
# drag/delete local tasks) — those work regardless. See docs/tasks.md.
MULLION_TASK_MASTER_ENABLED=false

# GitHub issue label the task watcher polls for, once Task Master is
# enabled. Every open issue carrying this label on a connected, locally-
# hosted project's repo becomes a task. Restart-only — not overridable from
# Settings (changing it mid-flight would orphan already-labeled issues).
MULLION_TASK_LABEL=mullion-task

# Seconds between task-watcher poll sweeps. Restart-only — not overridable
# from Settings.
MULLION_TASK_POLL_INTERVAL=60

# Task Master safety envelope — deploy-time DEFAULT install-wide cap on
# tasks in claimed/in_progress at once, enforced transactionally at claim
# time. Overridable at runtime via Settings -> Task Master.
MULLION_TASK_MAX_CONCURRENT=2

# Task Master safety envelope — deploy-time DEFAULT wall-clock minutes a
# claim gets before the reconciler force-fails it and terminates its
# session. 0 = unlimited. Overridable at runtime via Settings -> Task Master.
MULLION_TASK_BUDGET_MINUTES=120

# Task Master GitHub sync (6.4) — deploy-time DEFAULT minimum minutes
# between two "in_progress" progress comments posted to the same linked
# issue. 0 = no throttle. Overridable at runtime via Settings -> Task Master.
MULLION_TASK_PROGRESS_COMMENT_MINUTES=15

# Multi-host support — see docs/multi-host.md: primary | agent. Leave as
# primary for a normal single-process deployment. "agent" is a lightweight,
# DB-less process meant to run on a remote host, exposing only a
# token-gated internal API (src/routes/internal.ts) that a primary uses to
# spawn/attach/terminate sessions on it.
MULLION_ROLE=primary

# Signs the session cookie issued once MULLION_AUTH_TOKEN or MULLION_OIDC_*
# (issue #30) is configured. Required whenever in-process auth is enabled —
# the process refuses to boot with a token set but no session secret, since
# an unsigned cookie would be forgeable. Generate with:
#   openssl rand -hex 32
# Rotating it invalidates all existing sessions (forces re-login).
MULLION_SESSION_SECRET=

# "owner/repo" polled for the latest GitHub Release by the update checker
# (GET /api/updates/check) — same public, unauthenticated GitHub REST API as
# the project-integrations feature, just the /releases/latest endpoint.
# Defaults to this project's own repo; override only for a fork publishing
# releases elsewhere.
MULLION_UPDATE_REPO=s3ntin3l8/mullion-session-manager

# Override for the systemd --user unit self-update.sh restarts after
# applying an update. Leave empty (the default) to autodetect it from this
# process's own /proc/self/cgroup at apply time — a normal
# deploy/install.sh install (or a later rename of that unit) needs no
# override, since detection reads whatever unit is actually running. Set
# this only if a host's cgroup layout defeats autodetection.
MULLION_SERVICE_UNIT=

# Public base URL for GitHub webhook delivery. Must be an externally-
# accessible https:// URL with no trailing path (the backend appends
# /api/webhooks/github). Empty or unset disables webhook support entirely
# — polling alone is always active as a fallback. See docs/github-integration.md.
MULLION_WEBHOOK_BASE_URL=

# HMAC-SHA256 secret for webhook payload verification. Optional — if
# empty on first enable, the webhook registration service auto-generates a
# random secret and stores it encrypted in the DB. See docs/github-integration.md.
MULLION_WEBHOOK_SECRET=

# Path for the Phase 4 control socket (see docs/socket-api.md) — the
# transport behind the `mullion` CLI. Empty (the default) derives it from
# SESSIONS_DIR (`<SESSIONS_DIR>/mullion.sock`), alongside the existing hook
# socket. Set this only to relocate the socket off SESSIONS_DIR entirely.
MULLION_SOCKET_PATH=
