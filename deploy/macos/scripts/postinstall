#!/bin/bash
# Round 4+ — runs after pkgbuild's payload lands mullion-helper at
# /usr/local/bin/mullion-helper. installer(8) always runs package scripts
# as root, regardless of how the .pkg itself was launched.
#
# Deliberately does not `set -e`: a failure at any step still leaves a
# USABLE install (the binary is on disk either way), so this degrades
# to a printed warning with the exact retry command, never a failed .pkg.
set -u

EXE="/usr/local/bin/mullion-helper"

if [ ! -x "$EXE" ]; then
  echo "mullion-helper: binary not found at $EXE — pkg payload may have failed to install."
  echo "Re-install the .pkg or copy mullion-helper to $EXE manually."
  exit 1
fi

# Resolve the console user (the person actually sitting at this Mac).
# installer(8) does NOT propagate $SUDO_USER — /dev/console is the only
# reliable signal in the non-interactive case.
CONSOLE_USER="$(stat -f '%Su' /dev/console 2>/dev/null || true)"
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ]; then
  echo "mullion-helper: could not determine the logged-in console user — skipping 'helper install'."
  echo "Run it yourself once logged in: $EXE helper install --ssh-auth-sock <path>"
  exit 0
fi

CONSOLE_UID="$(id -u "$CONSOLE_USER" 2>/dev/null || true)"
if [ -z "$CONSOLE_UID" ]; then
  echo "mullion-helper: could not resolve a uid for console user '$CONSOLE_USER' — skipping 'helper install'."
  echo "Run it yourself once logged in: $EXE helper install --ssh-auth-sock <path>"
  exit 0
fi

# 1Password's fixed macOS agent socket path — the common default.
# resolveSshAuthSock WARNS (never fails) if this path doesn't exist yet.
CONSOLE_HOME="$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
if [ -z "$CONSOLE_HOME" ]; then
  CONSOLE_HOME="/Users/$CONSOLE_USER"
fi
SSH_AUTH_SOCK_DEFAULT="$CONSOLE_HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Try to run helper install as the console user.
# -H pins $HOME to CONSOLE_USER's home directory.
if launchctl asuser "$CONSOLE_UID" sudo -u "$CONSOLE_USER" -H \
     "$EXE" helper install --ssh-auth-sock "$SSH_AUTH_SOCK_DEFAULT"; then
  echo "mullion-helper: installed successfully for $CONSOLE_USER."
  echo "  SSH_AUTH_SOCK = $SSH_AUTH_SOCK_DEFAULT"
  echo "  Launchd job: gui/$CONSOLE_UID/de.s3ntin3l8.mullion-helper"
else
  EXIT_CODE=$?
  echo ""
  echo "mullion-helper: 'helper install' exited with code $EXIT_CODE — the binary is still installed at $EXE."

  # Diagnose common failure modes
  if [ "$EXIT_CODE" -eq 4 ]; then
    echo ""
    echo "This may be a permissions issue. Try:"
    echo "  1. Open System Settings → Privacy & Security → Security"
    echo "  2. Click 'Allow' next to the mullion-helper warning"
    echo "  3. Re-run: $EXE helper install --ssh-auth-sock <path>"
    echo ""
    echo "Or bypass Gatekeeper for this binary:"
    echo "  sudo xattr -dr com.apple.quarantine $EXE"
  fi

  echo ""
  echo "Retry yourself: $EXE helper install --ssh-auth-sock <path>"
fi

exit 0
